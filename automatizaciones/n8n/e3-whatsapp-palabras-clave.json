    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Saca los mensajes de lo que manda Meta. Ignora avisos de estado (entregado, leído).\nconst salida = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const valor = j.messages ? j : (j.body && j.body.entry ? j.body.entry[0].changes[0].value : j);\n  const contacto = (valor.contacts || [])[0] || {};\n  for (const m of valor.messages || []) {\n    let texto = '';\n    if (m.type === 'text') texto = m.text.body;\n    else if (m.type === 'button') texto = m.button.text;\n    else if (m.type === 'interactive') texto = (m.interactive.button_reply || m.interactive.list_reply || {}).title || '';\n    else texto = '[' + m.type + ']';\n    salida.push({ json: { de: m.from, nombre: (contacto.profile || {}).name || '', texto, tipo: m.type, idMensaje: m.id, fecha: new Date(Number(m.timestamp) * 1000).toISOString() } });\n  }\n}\nreturn salida;"
      },
      "id": "9f26a5d7-cf29-454e-bfd0-59c34cc96fb2",
      "name": "Leer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Respuestas por palabra clave. Edite las listas y los textos para cada negocio.\n// La primera regla que coincide gana. Sin tildes ni mayúsculas para comparar.\nconst n = $('Datos del negocio').first().json;\nconst normal = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst texto = normal($input.item.json.texto);\nconst reglas = [\n  { clave: 'persona', palabras: ['persona', 'asesor', 'humano', 'hablar con', 'llamar', 'llamen', 'urgente', 'queja'],\n    respuesta: 'Con gusto. Ya le avisé al equipo de ' + n.negocio + ' y le escriben por aquí en cuanto estén disponibles.' },\n  { clave: 'precios', palabras: ['precio', 'cuanto', 'vale', 'cuesta', 'valor', 'tarifa', 'catalogo', 'menu'],\n    respuesta: 'Aquí puede ver todos los precios: ' + n.enlaceCatalogo + ' ¿Le ayudo con algo en especial?' },\n  { clave: 'horario', palabras: ['horario', 'hora', 'abren', 'cierran', 'abierto', 'domingo', 'festivo'],\n    respuesta: 'Nuestro horario es ' + n.horario + '.' },\n  { clave: 'ubicacion', palabras: ['donde', 'direccion', 'ubicacion', 'quedan', 'llegar', 'mapa'],\n    respuesta: 'Estamos en ' + n.direccion + '. Así llega: ' + n.enlaceMaps },\n  { clave: 'pago', palabras: ['pago', 'pagar', 'nequi', 'daviplata', 'bre-b', 'breb', 'transferencia', 'tarjeta', 'efectivo'],\n    respuesta: 'Recibimos ' + n.mediosPago + '.' }\n];\nconst regla = reglas.find((r) => r.palabras.some((p) => texto.includes(p)));\nreturn { json: { ...$input.item.json,\n  coincidio: !!regla,\n  categoria: regla ? regla.clave : 'otro',\n  pidePersona: !!regla && regla.clave === 'persona',\n  respuesta: regla ? regla.respuesta : n.respuestaPorDefecto,\n  usarIA: n.usarIA === 'si' && !regla } };"
      },
      "id": "a7c7e5c0-0d2c-49cd-9556-e879a607f0ea",
      "name": "Respuesta por palabra clave",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
