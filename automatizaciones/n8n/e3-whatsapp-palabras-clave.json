    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-5-5\",\n  \"max_tokens\": 300,\n  \"system\": {{ JSON.stringify('Eres el asistente de WhatsApp de ' + $('Datos del negocio').first().json.negocio + '. Responde en español, con trato de usted, en máximo 3 frases. Usa SOLO esta información del negocio: ' + $('Datos del negocio').first().json.infoParaIA + ' Si no sabes algo, di que una persona del equipo le responde pronto. Nunca inventes precios, horarios ni promociones. No pidas datos personales sensibles.') }},\n  \"messages\": [{ \"role\": \"user\", \"content\": {{ JSON.stringify($json.texto) }} }]\n}",
        "options": {}
      },
