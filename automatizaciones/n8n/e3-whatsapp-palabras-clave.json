    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Usa la respuesta de la IA solo si estaba activada y devolvió texto.\nconst base = $('Respuesta por palabra clave').item.json;\nconst ia = $input.item.json;\nlet texto = base.respuesta;\nlet fuente = base.coincidio ? 'palabra clave' : 'respuesta por defecto';\nif (base.usarIA && ia && Array.isArray(ia.content) && ia.content[0] && ia.content[0].text) {\n  texto = ia.content[0].text.trim().slice(0, 900);\n  fuente = 'IA';\n}\nreturn { json: { ...base, texto, fuente } };"
      },
