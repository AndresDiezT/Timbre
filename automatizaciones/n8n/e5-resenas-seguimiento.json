    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Decide qué mensaje le toca hoy a cada cliente de la hoja \"Clientes\".\n// Columnas: ID, Cliente, Teléfono, Estado (Cotizó / Pagó / ...), FechaCotizacion (AAAA-MM-DD),\n// RespondioCotizacion (Sí si contestó), Seguimiento1, Seguimiento2, ResenaEnviada.\nconst n = $('Datos del negocio').first().json;\nconst hoy = new Date(new Date().toLocaleString('en-US', { timeZone: n.zonaHoraria }));\nhoy.setHours(0, 0, 0, 0);\nconst dias = (f) => Math.round((hoy - new Date(f + 'T00:00:00')) / 86400000);\nconst salida = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c.ID || !c['Teléfono']) continue;\n  const estado = String(c.Estado || '').toLowerCase();\n  let accion = null;\n  if (estado.startsWith('pag') && !c.ResenaEnviada) accion = 'resena';\n  else if (estado.startsWith('cotiz') && !/^s/i.test(c.RespondioCotizacion || '') && c.FechaCotizacion) {\n    const d = dias(c.FechaCotizacion);\n    if (d >= 2 && d < 5 && !c.Seguimiento1) accion = 'seguimiento1';\n    else if (d >= 5 && d < 10 && !c.Seguimiento2) accion = 'seguimiento2';\n  }\n  if (!accion) continue;\n  let telefono = String(c['Teléfono']).replace(/\\D/g, '');\n  if (telefono.length === 10) telefono = String(n.indicativoPais || '57') + telefono;\n  const plantillas = { resena: n.plantillaResena, seguimiento1: n.plantillaSeguimiento1, seguimiento2: n.plantillaSeguimiento2 };\n  const variables = accion === 'resena' ? [String(c.Cliente || '').split(' ')[0], n.negocio, n.enlaceResenas] : [String(c.Cliente || '').split(' ')[0], n.negocio];\n  salida.push({ json: { id: String(c.ID), accion, telefono, plantilla: plantillas[accion], variables } });\n}\nreturn salida;"
      },
      "id": "4f1d3d51-3d2f-469d-ba28-cfde1ad0b841",
      "name": "¿Qué enviar hoy?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
