    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida el formulario y deja los datos limpios.\nconst d = $input.item.json.body || $input.item.json;\nconst si = (v) => v === true || v === 'true' || v === 'on' || v === 'si' || v === 'sí';\nif (!si(d.autorizacion)) {\n  throw new Error('El formulario llegó sin la autorización de datos (Ley 1581). No se guarda nada.');\n}\nconst limpio = (v, max = 500) => String(v || '').trim().slice(0, max);\n// WhatsApp necesita el número con indicativo y sin signos (ej.: 573001234567).\nlet telefono = limpio(d.telefono, 30).replace(/\\D/g, '');\nconst indicativo = String($('Datos del negocio').item.json.indicativoPais || '57');\nif (telefono.length === 10) telefono = indicativo + telefono;\nreturn {\n  json: {\n    ...$('Datos del negocio').item.json,\n    fecha: new Date().toISOString(),\n    nombre: limpio(d.nombre, 80),\n    primerNombre: limpio(d.nombre, 80).split(' ')[0],\n    telefono,\n    correo: limpio(d.correo, 120).toLowerCase(),\n    servicio: limpio(d.servicio, 80),\n    mensaje: limpio(d.mensaje, 1000),\n    autorizacion: 'Sí (' + new Date().toISOString().slice(0, 10) + ')',\n    origen: limpio(d.origen || 'Formulario web', 60)\n  }\n};"
      },
      "id": "e459c54a-c589-472b-b4a9-ebc716b9ce48",
      "name": "Validar y limpiar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Datos del negocio').item.json.whatsappPhoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": {{ JSON.stringify($json.plantilla) }},\n    \"language\": { \"code\": \"{{ $json.idiomaPlantilla }}\" },\n    \"components\": [{ \"type\": \"body\", \"parameters\": [{ \"type\": \"text\", \"text\": {{ JSON.stringify($json.primerNombre) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.negocio) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.servicio || 'su solicitud') }} }] }]\n  }\n}",
        "options": {}
      },
