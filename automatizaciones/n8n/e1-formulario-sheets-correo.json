    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida el formulario y deja los datos limpios.\nconst d = $input.item.json.body || $input.item.json;\nconst si = (v) => v === true || v === 'true' || v === 'on' || v === 'si' || v === 'sí';\nif (!si(d.autorizacion)) {\n  throw new Error('El formulario llegó sin la autorización de datos (Ley 1581). No se guarda nada.');\n}\nconst limpio = (v, max = 500) => String(v || '').trim().slice(0, max);\nconst telefono = limpio(d.telefono, 30).replace(/[^\\d+]/g, '');\nreturn {\n  json: {\n    ...$('Datos del negocio').item.json,\n    fecha: new Date().toISOString(),\n    nombre: limpio(d.nombre, 80),\n    primerNombre: limpio(d.nombre, 80).split(' ')[0],\n    telefono,\n    correo: limpio(d.correo, 120).toLowerCase(),\n    servicio: limpio(d.servicio, 80),\n    mensaje: limpio(d.mensaje, 1000),\n    autorizacion: 'Sí (' + new Date().toISOString().slice(0, 10) + ')',\n    origen: limpio(d.origen || 'Formulario web', 60)\n  }\n};"
      },
