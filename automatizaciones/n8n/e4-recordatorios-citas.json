        "url": "=https://graph.facebook.com/v21.0/{{ $('Datos del negocio').item.json.whatsappPhoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": {{ JSON.stringify($json.plantilla) }},\n    \"language\": { \"code\": \"{{ $('Datos del negocio').first().json.idiomaPlantilla }}\" },\n    \"components\": [{ \"type\": \"body\", \"parameters\": [{ \"type\": \"text\", \"text\": {{ JSON.stringify($json.cliente) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.servicio) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.fechaTexto) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.horaTexto) }} }, { \"type\": \"text\", \"text\": {{ JSON.stringify($json.negocio) }} }] }]\n  }\n}",
        "options": {}
      },
