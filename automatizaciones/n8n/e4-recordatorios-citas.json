    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Busca citas a las que les toca recordatorio ahora (24 h o 2 h antes).\n// La hoja \"Citas\" tiene: ID, Cliente, Teléfono, Fecha (AAAA-MM-DD), Hora (HH:MM), Servicio, Estado, Recordatorio24, Recordatorio2.\n// Se ejecuta cada 15 minutos; la ventana evita enviar dos veces.\nconst n = $('Datos del negocio').first().json;\nconst zona = n.desfaseUTC || '-05:00';\nconst ahora = Date.now();\nconst salida = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c.ID || !c['Teléfono'] || !c.Fecha || !c.Hora) continue;\n  if (String(c.Estado || '').toLowerCase().includes('cancel')) continue;\n  const cita = new Date(c.Fecha + 'T' + c.Hora + ':00' + zona).getTime();\n  const faltan = (cita - ahora) / 3600000;\n  let tipo = null;\n  if (!c.Recordatorio24 && faltan <= 24 && faltan > 2.5) tipo = '24';\n  else if (!c.Recordatorio2 && faltan <= 2 && faltan > 0) tipo = '2';\n  if (!tipo) continue;\n  let telefono = String(c['Teléfono']).replace(/\\D/g, '');\n  if (telefono.length === 10) telefono = String(n.indicativoPais || '57') + telefono;\n  salida.push({ json: {\n    id: String(c.ID), tipo, telefono,\n    cliente: String(c.Cliente || '').split(' ')[0],\n    servicio: c.Servicio || 'su cita',\n    fechaTexto: new Date(cita).toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long', timeZone: n.zonaHoraria }),\n    horaTexto: new Date(cita).toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', timeZone: n.zonaHoraria }),\n    plantilla: tipo === '24' ? n.plantilla24 : n.plantilla2,\n    negocio: n.negocio\n  } });\n}\nreturn salida;"
      },
      "id": "a7e570f1-0e4e-4ff6-aba4-c1e211dfb5e0",
      "name": "¿A quién recordar?",
      "type": "n8n-nodes-base.code",
